{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": [
      "blue",
      "purple",
      "cyan",
      "green",
      "orange",
      "red",
      "pink"
    ],
    "text": {
      "base": "$hue.neutral.100",
      "muted": "$hue.neutral.300",
      "action": {
        "primary": {
          "base": "$text.base",
          "$selected": "$hue.interactive.400",
          "$disabled": "$hue.neutral.300"
        },
        "secondary": {
          "base": "$text.muted",
          "$hovered": "$text.base"
        },
        "destructive": {
          "base": "$hue.neutral.900",
          "$disabled": "$hue.neutral.300"
        }
      },
      "formfield": {
        "base": "$text.base",
        "$hovered": "$hue.interactive.400",
        "$focused": "$hue.interactive.400",
        "$pressed": "$hue.interactive.400",
        "$disabled": "$text.muted",
        "$selected": "$hue.interactive.400"
      },
      "feedback": {
        "error": {
          "base": "$hue.red.400"
        },
        "warning": {
          "base": "$hue.yellow.400"
        },
        "success": {
          "base": "$hue.green.400"
        },
        "info": {
          "base": "$hue.blue.400"
        }
      }
    },
    "background": {
      "base": "$hue.neutral.900",
      "raised": {
        "base": "$hue.neutral.800",
        "high": "$hue.neutral.700",
        "max": "$hue.neutral.600"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$hue.neutral.700",
          "$focused": "$hue.interactive.600",
          "$selected": "transparent"
        },
        "secondary": {
          "base": "transparent"
        },
        "destructive": {
          "base": "$hue.red.400"
        }
      },
      "formfield": {
        "base": "$background.base"
      },
      "feedback": {
        "error": {
          "base": "$background.base"
        },
        "warning": {
          "base": "$background.base"
        },
        "success": {
          "base": "$background.base"
        },
        "info": {
          "base": "$background.base"
        }
      }
    },
    "border": {
      "base": "$hue.neutral.600"
    },
    "scrollbar": {
      "base": "$hue.neutral.500"
    },
    "diff": {
      "text": {
        "added": "$hue.green.400",
        "removed": "$hue.red.400",
        "context": "$hue.neutral.400",
        "hunkHeader": "$hue.blue.400"
      },
      "background": {
        "added": "#2D3A28",
        "removed": "#3A2222",
        "context": "$background.base"
      },
      "highlight": {
        "added": "$hue.green.400",
        "removed": "$hue.red.400"
      },
      "lineNumber": {
        "text": "$hue.neutral.400",
        "background": {
          "added": "$background.base",
          "removed": "$background.base"
        }
      }
    },
    "syntax": {
      "comment": "$hue.neutral.400",
      "keyword": "$hue.blue.400",
      "function": "$hue.blue.400",
      "variable": "$hue.neutral.200",
      "string": "$hue.green.400",
      "number": "$hue.orange.400",
      "type": "$hue.cyan.400",
      "operator": "$hue.orange.400",
      "punctuation": "$hue.neutral.200"
    },
    "markdown": {
      "text": "$hue.neutral.100",
      "heading": "$hue.blue.400",
      "link": "$hue.cyan.400",
      "linkText": "$hue.yellow.400",
      "code": "$hue.green.400",
      "blockQuote": "$hue.neutral.400",
      "emphasis": "$hue.purple.400",
      "strong": "$hue.neutral.200",
      "horizontalRule": "$hue.neutral.600",
      "listItem": "$hue.neutral.100",
      "listEnumeration": "$hue.neutral.400",
      "image": "$hue.cyan.400",
      "imageText": "$hue.cyan.400",
      "codeBlock": "$hue.green.400"
    },
    "@dialog": {
      "text": {
        "muted": "$hue.neutral.200",
        "action": {
          "secondary": {
            "base": "$text.base"
          }
        }
      },
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": {
            "$hovered": "$background.raised.max"
          },
          "secondary": {
            "$hovered": "$background.raised.max"
          }
        }
      },
      "@footer": {
        "text": {
          "muted": "$hue.neutral.200"
        }
      }
    }
  },
